rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Core player state (authoritative)
    match /player_stats/{userId} {
      allow get, create, update, delete: if isOwner(userId);
      allow list: if false;

      // Board state
      match /grid_items/{itemId} {
        allow read, write: if isOwner(userId);
      }

      // Daily quests (client-generated/progress)
      match /daily_quests/{questId} {
        allow read, write: if isOwner(userId);
      }

      // Weekly event quests (client-generated/progress)
      match /event_quests/{questId} {
        allow read, write: if isOwner(userId);
      }

      // Daily challenge snapshots and metadata
      match /daily_challenges/{dayKey} {
        allow read, write: if isOwner(userId);
      }
    }

    // Achievements are stored under users/{uid}/achievements
    match /users/{userId} {
      allow get, create, update, delete: if isOwner(userId);
      allow list: if false;

      match /achievements/{achievementId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Legacy fallback collection used during migration.
    // Restrict to the authenticated user's rows.
    match /grid_items/{itemId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }
  }
}
